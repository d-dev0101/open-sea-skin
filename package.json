{
  "name": "open-sea-skin",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Open Sea WebGPU new-tab extension and DeepSeek Harness skin",
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "check:generated": "node scripts/build-runtime.mjs --check",
    "test": "node --test tests/*.test.mjs",
